{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vault export reconciliation",
  "description": "An exported finalized vault/bond/reward/pot snapshot. The checker asserts conservation, uniqueness and non-negativity; the operator's authenticated export is the external input.",
  "type": "object",
  "required": ["schema", "checkpoint", "entries", "totals"],
  "properties": {
    "schema": {"const": 1},
    "checkpoint": {
      "type": "object",
      "required": ["height", "hash"],
      "properties": {
        "height": {"type": "integer", "minimum": 0},
        "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "balance"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["vault", "bond", "reward", "pot"]},
          "balance": {"type": "integer", "minimum": 0}
        }
      }
    },
    "totals": {
      "type": "object",
      "required": ["supply", "vaults", "bonded", "rewards", "pot"],
      "properties": {
        "supply": {"type": "integer", "minimum": 0},
        "vaults": {"type": "integer", "minimum": 0},
        "bonded": {"type": "integer", "minimum": 0},
        "rewards": {"type": "integer", "minimum": 0},
        "pot": {"type": "integer", "minimum": 0}
      }
    }
  }
}
