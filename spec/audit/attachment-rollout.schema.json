{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Attachment rollout record",
  "description": "The selected attachment-aware release, every validator's activation, and the old/new client refusal evidence. A mixed-version or still-serving-old validator is a fail.",
  "type": "object",
  "required": ["schema", "selected", "validators", "window_seconds"],
  "properties": {
    "schema": {"const": 1},
    "selected": {
      "type": "object",
      "required": ["source_sha", "artifact_digest", "binary_sha256"],
      "properties": {
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "artifact_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "binary_sha256", "activated_utc", "still_serving_old"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "binary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "activated_utc": {"type": "string", "minLength": 10},
          "still_serving_old": {"type": "boolean"}
        }
      }
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "supports_attachments", "refuses_old"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "supports_attachments": {"type": "boolean"},
          "refuses_old": {"type": "boolean"}
        }
      }
    },
    "window_seconds": {"type": "integer", "minimum": 1}
  }
}
