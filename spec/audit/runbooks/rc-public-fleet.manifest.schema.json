{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rhovision-org/rholo/spec/audit/runbooks/rc-public-fleet.manifest.schema.json",
  "title": "rc-public-fleet manifest",
  "description": "The input contract for tools/fleet-run.py and every public arm. It names four nodes, the candidate pins, the one deploy plan and the action policy, plus the typed fault/availability/pressure/join/upgrade inputs the driver consumes. It carries inputs only: harness results, cycles, the victim, boot ids, post heads, certificates, pressure records, join results and upgrade records are produced by the driver or read by the claim, and a manifest containing them is refused. The committed record carries a redacted copy; a redacted manifest is evidence, not an input.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "campaign", "generated_at_utc", "locality", "transport", "provenance", "nodes"
  ],
  "properties": {
    "schema": { "const": 1 },
    "campaign": { "const": "rc-public-fleet" },
    "generated_at_utc": { "type": "string" },
    "locality": { "enum": ["public-live", "local-devnet", "single-host"] },
    "transport": { "enum": ["ssh-systemd", "docker"] },
    "rehearsal": {
      "type": "boolean",
      "description": "True only for the local dress rehearsal. A public-live run must not set it, and a rehearsal record never reads safe."
    },
    "provenance": {
      "type": "object",
      "required": ["source_sha", "binary_sha256"],
      "properties": {
        "source_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "binary_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "genesis_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "genesis_raw_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bonds_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "network_id": { "type": "string" },
        "shard_id": { "type": "string" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "host", "http"],
        "properties": {
          "name": { "type": "string" },
          "host": {
            "type": "string",
            "description": "Stable declared host label. A public run needs four distinct, non-loopback, non-private labels; the label is never resolved."
          },
          "p2p_host": {
            "type": "string",
            "description": "Optional address the partition driver drops. Defaults to the declared host label."
          },
          "ssh": { "type": "string", "description": "user@host for the ssh-systemd transport" },
          "unit": { "type": "string", "description": "systemd unit, or docker container name" },
          "binary_path": { "type": "string" },
          "data_dir": { "type": "string" },
          "http": { "type": "string" },
          "admin": { "type": "string" },
          "grpc_host": { "type": "string", "default": "127.0.0.1" },
          "grpc_port": { "type": "integer", "minimum": 1, "maximum": 65535 }
        },
        "additionalProperties": false
      }
    },
    "deploy": {
      "type": "object",
      "required": ["from", "marker", "value", "phlo_limit", "phlo_price", "shard_id", "relay"],
      "properties": {
        "from": { "type": "string", "description": "Node name whose host runs the deploy CLI" },
        "marker": { "type": "string" },
        "value": { "type": "integer" },
        "term": { "type": "string" },
        "term_file": { "type": "string" },
        "term_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "phlo_limit": { "type": "integer", "minimum": 1 },
        "phlo_price": { "type": "integer", "minimum": 0 },
        "shard_id": { "type": "string" },
        "private_key_path": {
          "type": "string",
          "description": "Remote path to a 0600 deployer key. Never key material, never an argv value."
        },
        "relay": {
          "type": "object",
          "required": ["mode", "aliases", "reachability_checked_utc", "unreachable_aliases"],
          "properties": {
            "mode": { "enum": ["relay", "four-ingress"] },
            "aliases": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "uniqueItems": true,
              "items": { "type": "string" }
            },
            "destination_port": { "type": ["integer", "null"], "minimum": 1, "maximum": 65535 },
            "reachability_checked_utc": { "type": "string" },
            "unreachable_aliases": { "type": "array", "maxItems": 0 },
            "signed_payload_file": {
              "type": "string",
              "description": "Required for four-ingress: one pre-signed DeployRequest, offered to all four ingresses. No Python signer is invented."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "actions": {
      "type": "object",
      "properties": {
        "survivor_advance_blocks": { "type": "integer", "minimum": 1, "default": 3 },
        "rejoin_margin_blocks": { "type": "integer", "minimum": 1, "default": 3 },
        "epoch_length": {
          "type": "integer",
          "minimum": 1,
          "description": "The genesis epoch length. Required by RC-1: retention is sampled across two further epoch boundaries."
        },
        "retention_epochs": { "type": "integer", "minimum": 1, "default": 2 },
        "timeouts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "preflight_s": { "type": "integer", "minimum": 1 },
            "deploy_s": { "type": "integer", "minimum": 1 },
            "settle_s": { "type": "integer", "minimum": 1 },
            "stop_s": { "type": "integer", "minimum": 1 },
            "advance_s": { "type": "integer", "minimum": 1 },
            "start_s": { "type": "integer", "minimum": 1 },
            "rejoin_s": { "type": "integer", "minimum": 1 },
            "trace_s": { "type": "integer", "minimum": 1 }
          }
        }
      },
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "fields": { "type": "array", "items": { "type": "string" } },
        "host_pseudonyms": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    },
    "operator_fields": { "type": "object" },
    "fault": {
      "type": "object",
      "description": "RC-2's partition input. It names the policy, never the victim or the outcome.",
      "required": ["kind", "cycles", "victim_policy", "p2p_ports", "mechanism",
                   "dwell_blocks", "dwell_seconds", "heal_timeout_s"],
      "properties": {
        "kind": { "const": "partition" },
        "cycles": { "type": "integer", "minimum": 1 },
        "victim_policy": { "type": "string" },
        "p2p_ports": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "mechanism": { "enum": ["nftables", "docker-network"] },
        "dwell_blocks": { "type": "integer", "minimum": 1 },
        "dwell_seconds": { "type": "integer", "minimum": 1 },
        "heal_timeout_s": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "description": "RC-3/RC-6 availability sweep input; the block list is produced by the driver.",
      "required": ["window_blocks", "probe_timeout_s"],
      "properties": {
        "window_blocks": { "type": "integer", "minimum": 10 },
        "probe_timeout_s": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "pressure": {
      "type": "object",
      "description": "RC-5's pressure input. The transcript, counts and verdict are outputs.",
      "required": ["endpoint", "host", "port", "cap", "probes", "mode_order", "settle_s"],
      "properties": {
        "endpoint": { "type": "string", "pattern": "^https?://" },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "cap": { "type": "integer", "minimum": 1 },
        "probes": { "type": "integer", "minimum": 1 },
        "mode_order": { "type": "array", "minItems": 1, "uniqueItems": true,
                        "items": { "enum": ["capped", "unset"] } },
        "settle_s": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "join": {
      "type": "object",
      "description": "RC-6's fresh-joiner input. The chain, audit and checkpoint are outputs.",
      "required": ["joiner", "bootstrap_from", "fresh_store", "min_height", "timeout_s"],
      "properties": {
        "joiner": { "type": "object" },
        "bootstrap_from": { "type": "string" },
        "fresh_store": { "const": true },
        "min_height": { "type": "integer", "minimum": 1 },
        "timeout_s": { "type": "integer", "minimum": 1 },
        "audit_config": { "type": ["string", "object"] }
      },
      "additionalProperties": false
    },
    "upgrade": {
      "type": "object",
      "description": "RC-7's rolling-swap input; the driver lands in the rc-fleet-upgrade window.",
      "required": ["old", "new_binary_path", "old_binary_path", "order", "staging_host",
                   "mixed_window_blocks", "rollback_on_refusal", "timeout_s"],
      "properties": {
        "old": { "type": "object" },
        "new_binary_path": { "type": "string" },
        "old_binary_path": { "type": "string" },
        "order": { "type": "array", "minItems": 4, "maxItems": 4,
                   "items": { "type": "string" } },
        "staging_host": { "type": "string" },
        "mixed_window_blocks": { "type": "integer", "minimum": 1 },
        "rollback_on_refusal": { "type": "boolean" },
        "timeout_s": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "cycles": { "description": "OUTPUT. tools/fleet_manifest.validate refuses it as an input." },
    "pressure_record": { "description": "OUTPUT. The driver produces the pressure record." },
    "join_result": { "description": "OUTPUT. The join driver performs the join." },
    "audit_bootstrap": { "description": "OUTPUT. The join driver runs the audit." },
    "upgrade_record": { "description": "OUTPUT. The upgrade driver produces it." },
    "harness_result": { "description": "OUTPUT. The driver performs the action and records it." },
    "redactions": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Present only on a redacted evidence copy, never on a runnable input."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "transport": { "const": "ssh-systemd" } } },
      "then": {
        "properties": {
          "locality": { "const": "public-live" },
          "nodes": {
            "items": {
              "required": ["ssh", "unit", "binary_path", "data_dir"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "transport": { "const": "docker" } } },
      "then": {
        "properties": {
          "locality": { "enum": ["local-devnet", "single-host"] }
        }
      }
    }
  ]
}
